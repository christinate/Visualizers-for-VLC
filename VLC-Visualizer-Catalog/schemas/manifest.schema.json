{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLC Visualizer Addon package manifest",
  "type": "object",
  "required": [
    "schema_version",
    "api_version",
    "id",
    "name",
    "version",
    "architecture",
    "adapter",
    "entrypoint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "const": "x86_64"
    },
    "platform": {
      "const": "windows"
    },
    "adapter": {
      "enum": [
        "geiss",
        "winamp"
      ]
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.dll$"
    },
    "settings": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

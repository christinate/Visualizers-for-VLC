{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLC Visualizer Addon native Dawn API 4 package manifest",
  "type": "object",
  "required": ["schema_version", "api_version", "id", "name", "version", "platform", "architecture", "adapter", "entrypoint", "assets", "dawn_revision"],
  "properties": {
    "schema_version": {"const": 4},
    "api_version": {"const": 4},
    "id": {"type": "string", "pattern": "^[a-z0-9_-]{1,64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "platform": {"enum": ["windows", "macos", "linux"]},
    "architecture": {"enum": ["x86_64", "arm64"]},
    "adapter": {"const": "dawn"},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(dll|so|dylib)$"},
    "assets": {"type": "string", "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"},
    "dawn_revision": {"const": "7daf3b0bee2c73621001ab15b256b5a84fb0b45f"},
    "settings": {"type": "object"},
    "classic": {
      "type": "object",
      "required": ["entrypoint", "adapter"],
      "properties": {
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(dll|so|dylib)$"},
        "adapter": {"enum": ["geiss", "winamp", "opengl"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"platform": {"const": "windows"}}}, "then": {"properties": {"architecture": {"const": "x86_64"}, "entrypoint": {"pattern": "\\.dll$"}, "classic": {"properties": {"adapter": {"enum": ["geiss", "winamp"]}, "entrypoint": {"pattern": "\\.dll$"}}}}}},
    {"if": {"properties": {"platform": {"const": "linux"}}}, "then": {"properties": {"architecture": {"const": "x86_64"}, "entrypoint": {"pattern": "\\.so$"}, "classic": {"properties": {"adapter": {"const": "opengl"}, "entrypoint": {"pattern": "\\.so$"}}}}}},
    {"if": {"properties": {"platform": {"const": "macos"}}}, "then": {"properties": {"architecture": {"const": "arm64"}, "entrypoint": {"pattern": "\\.(so|dylib)$"}, "classic": {"properties": {"adapter": {"const": "opengl"}, "entrypoint": {"pattern": "\\.(so|dylib)$"}}}}}}
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLC Visualizer Addon WebGPU API 3 package manifest",
  "type": "object",
  "required": [
    "schema_version",
    "api_version",
    "id",
    "name",
    "version",
    "architecture",
    "adapter",
    "entrypoint",
    "platform"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "api_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "enum": [
        "x86_64",
        "arm64"
      ]
    },
    "adapter": {
      "const": "webgpu"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_./-]+\\.html$"
    },
    "settings": {
      "type": "object"
    },
    "platform": {
      "enum": [
        "windows",
        "linux",
        "macos"
      ]
    },
    "classic": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

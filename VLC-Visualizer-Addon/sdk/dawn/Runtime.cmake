# Shared native runtime/module services. No renderer checkout or probe sources.
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
if(NOT CMAKE_C_COMPILER_LOADED)
  enable_language(C)
endif()
if(APPLE)
  enable_language(OBJCXX)
  set(CMAKE_OBJCXX_STANDARD 20)
  set(CMAKE_OBJCXX_STANDARD_REQUIRED ON)
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "Native visualizers require a 64-bit target")
endif()
if(MSVC)
  set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
endif()
foreach(variable VIS_NATIVE_COMMON_INCLUDE VIS_NATIVE_API_DIR VIS_NATIVE_VENDOR VIS_MINIAUDIO_DIR)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "Set ${variable} before including Runtime.cmake")
  endif()
endforeach()
find_package(Threads REQUIRED GLOBAL)
find_package(Dawn CONFIG REQUIRED GLOBAL)
get_target_property(DAWN_LIBRARY_TYPE dawn::webgpu_dawn TYPE)
set(NATIVE_PLUGIN_DEFAULT OFF)
if(DAWN_LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
  set(NATIVE_PLUGIN_DEFAULT ON)
endif()
option(VIS_BUILD_NATIVE_PLUGINS "Build native plugin ABI modules and checks" ${NATIVE_PLUGIN_DEFAULT})
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies.lock.json" NATIVE_DEPENDENCIES)
string(JSON NATIVE_DAWN_REVISION GET "${NATIVE_DEPENDENCIES}" source_revision)
file(READ "${VIS_NATIVE_API_DIR}/visualizer_dawn_api.h" NATIVE_ABI_HEADER)
string(FIND "${NATIVE_ABI_HEADER}" "#define VIS_NATIVE_DAWN_REVISION \"${NATIVE_DAWN_REVISION}\"" PIN_POSITION)
file(READ "${VIS_NATIVE_COMMON_INCLUDE}/native_manifest.hpp" NATIVE_MANIFEST_HEADER)
string(FIND "${NATIVE_MANIFEST_HEADER}" "nativeDawnRevision=\"${NATIVE_DAWN_REVISION}\"" MANIFEST_PIN_POSITION)
if(PIN_POSITION EQUAL -1 OR MANIFEST_PIN_POSITION EQUAL -1)
  message(FATAL_ERROR "Native ABI/manifest headers and Dawn dependency revision differ")
endif()
if(VIS_BUILD_NATIVE_PLUGINS AND NOT DAWN_LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
  message(FATAL_ERROR "Native plugins require one shared, source-built Dawn library")
endif()

add_library(visualizer_image STATIC image_decode.cpp)
target_include_directories(visualizer_image PUBLIC .)
add_library(visualizer_text STATIC text_raster.cpp)
target_include_directories(visualizer_text PUBLIC .)
if(WIN32)
  target_sources(visualizer_image PRIVATE image_decode_win.cpp)
  target_compile_definitions(visualizer_image PUBLIC NOMINMAX _WIN32_WINNT=0x0A00)
  target_link_libraries(visualizer_image PRIVATE windowscodecs ole32)
  target_sources(visualizer_text PRIVATE text_raster_win.cpp)
  target_compile_definitions(visualizer_text PUBLIC NOMINMAX _WIN32_WINNT=0x0A00)
  target_link_libraries(visualizer_text PRIVATE dwrite d2d1 windowscodecs ole32)
  if(MSVC)
    target_compile_options(visualizer_image PUBLIC /utf-8 /EHsc)
    target_compile_options(visualizer_text PUBLIC /utf-8 /EHsc)
  endif()
elseif(APPLE)
  target_sources(visualizer_image PRIVATE image_decode_mac.mm)
  target_link_libraries(visualizer_image PRIVATE "-framework ImageIO" "-framework CoreGraphics" "-framework CoreFoundation")
  target_sources(visualizer_text PRIVATE text_raster_mac.mm)
  target_link_libraries(visualizer_text PRIVATE "-framework CoreText" "-framework CoreGraphics" "-framework CoreFoundation")
else()
  find_package(Qt6 REQUIRED COMPONENTS Gui)
  target_sources(visualizer_image PRIVATE image_decode_qt.cpp)
  target_link_libraries(visualizer_image PUBLIC Qt6::Gui)
  target_sources(visualizer_text PRIVATE text_raster_qt.cpp)
  target_link_libraries(visualizer_text PUBLIC Qt6::Gui)
endif()
add_library(visualizer_music STATIC music_analysis.cpp)
target_include_directories(visualizer_music PUBLIC .)
add_library(visualizer_player STATIC player_audio.cpp)
target_include_directories(visualizer_player PUBLIC . PRIVATE "${VIS_NATIVE_COMMON_INCLUDE}")
target_link_libraries(visualizer_player PUBLIC Threads::Threads visualizer_music)
add_library(visualizer_settings STATIC settings.cpp)
target_include_directories(visualizer_settings PUBLIC . "${VIS_NATIVE_VENDOR}" PRIVATE "${VIS_NATIVE_COMMON_INCLUDE}")
target_link_libraries(visualizer_settings PRIVATE Threads::Threads)
add_library(visualizer_dawn STATIC context.cpp shader_cache.cpp)
target_include_directories(visualizer_dawn PUBLIC . "${VIS_NATIVE_VENDOR}")
target_link_libraries(visualizer_dawn PUBLIC dawn::webgpu_dawn Threads::Threads)
if(WIN32)
  target_link_libraries(visualizer_dawn PRIVATE dxgi)
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  target_link_libraries(visualizer_dawn PRIVATE ${CMAKE_DL_LIBS})
endif()
add_library(visualizer_plugin STATIC plugin.cpp)
target_include_directories(visualizer_plugin PUBLIC "${VIS_NATIVE_API_DIR}")
target_link_libraries(visualizer_plugin PUBLIC visualizer_dawn visualizer_music ${CMAKE_DL_LIBS})
if(MSVC)
  foreach(library visualizer_dawn visualizer_player visualizer_settings)
    target_compile_options(${library} PUBLIC /utf-8 /EHsc)
    target_compile_definitions(${library} PUBLIC NOMINMAX _WIN32_WINNT=0x0A00)
  endforeach()
endif()

file(READ "${VIS_MINIAUDIO_DIR}/SOURCE.json" MINIAUDIO_SOURCE)
string(JSON MINIAUDIO_FILES LENGTH "${MINIAUDIO_SOURCE}" files)
math(EXPR MINIAUDIO_LAST "${MINIAUDIO_FILES}-1")
foreach(index RANGE 0 ${MINIAUDIO_LAST})
  string(JSON name GET "${MINIAUDIO_SOURCE}" files ${index} file)
  string(JSON expected GET "${MINIAUDIO_SOURCE}" files ${index} sha256)
  file(SHA256 "${VIS_MINIAUDIO_DIR}/${name}" found)
  if(NOT expected STREQUAL found)
    message(FATAL_ERROR "miniaudio source checksum mismatch: ${name}")
  endif()
endforeach()
add_library(visualizer_capture STATIC audio_capture.cpp "${VIS_MINIAUDIO_DIR}/miniaudio.c")
target_include_directories(visualizer_capture PUBLIC . PRIVATE "${VIS_MINIAUDIO_DIR}")
target_compile_definitions(visualizer_capture PRIVATE MA_NO_ENGINE MA_NO_RESOURCE_MANAGER MA_NO_NODE_GRAPH MA_NO_DECODING MA_NO_ENCODING MA_NO_GENERATION MA_NO_NULL)
target_link_libraries(visualizer_capture PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
if(WIN32)
  if(MSVC)
    target_compile_options(visualizer_capture PUBLIC /utf-8 $<$<COMPILE_LANGUAGE:CXX>:/EHsc>)
  endif()
  target_compile_definitions(visualizer_capture PRIVATE NOMINMAX MA_NO_DSOUND MA_NO_WINMM MA_NO_JACK)
  target_link_libraries(visualizer_capture PRIVATE ole32)
elseif(APPLE)
  target_compile_definitions(visualizer_capture PRIVATE MA_NO_PULSEAUDIO MA_NO_JACK)
  target_sources(visualizer_capture PRIVATE capture_permission_mac.mm)
  target_link_libraries(visualizer_capture PRIVATE "-framework Foundation" "-framework AVFoundation" "-framework CoreFoundation" "-framework CoreAudio" "-framework AudioToolbox")
else()
  target_compile_definitions(visualizer_capture PRIVATE MA_NO_JACK MA_NO_OSS MA_NO_SNDIO MA_NO_AUDIO4)
  target_link_libraries(visualizer_capture PRIVATE m)
endif()

option(VIS_BUILD_NATIVE_WINDOW "Build the native SDL/Dawn window runtime" OFF)
if(VIS_BUILD_NATIVE_WINDOW)
  if(NOT DAWN_LIBRARY_TYPE STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "The module-only window runtime requires shared Dawn")
  endif()
  find_package(SDL2 2.26 CONFIG REQUIRED)
  add_library(visualizer_window STATIC window.cpp)
  target_link_libraries(visualizer_window PUBLIC visualizer_dawn SDL2::SDL2)
  if(WIN32)
    target_link_libraries(visualizer_window PRIVATE dxgi)
  elseif(APPLE)
    target_sources(visualizer_window PRIVATE presentation_mac.mm)
    target_link_libraries(visualizer_window PRIVATE "-framework AppKit" "-framework QuartzCore" "-framework CoreGraphics")
  endif()
  add_library(visualizer_ui STATIC)
  target_include_directories(visualizer_ui PUBLIC .)
  target_link_libraries(visualizer_ui PUBLIC visualizer_settings)
  if(WIN32)
    target_sources(visualizer_ui PRIVATE input_picker_win.cpp settings_ui_win.cpp)
    target_link_libraries(visualizer_ui PRIVATE user32 gdi32)
    if(MSVC)
      target_compile_options(visualizer_ui PUBLIC /utf-8 /EHsc)
    endif()
  elseif(APPLE)
    target_sources(visualizer_ui PRIVATE input_picker_mac.mm settings_ui_mac.mm)
    set_source_files_properties(settings_ui_mac.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
    target_link_libraries(visualizer_ui PRIVATE "-framework AppKit")
  else()
    find_package(Qt6 REQUIRED COMPONENTS Widgets)
    target_sources(visualizer_ui PRIVATE input_picker_qt.cpp settings_ui_qt.cpp)
    target_link_libraries(visualizer_ui PRIVATE Qt6::Widgets)
  endif()
  add_library(visualizer_window_app STATIC window_demo.cpp)
  target_include_directories(visualizer_window_app PRIVATE "${VIS_NATIVE_COMMON_INCLUDE}")
  target_link_libraries(visualizer_window_app PUBLIC visualizer_window visualizer_plugin visualizer_capture visualizer_ui visualizer_player visualizer_text)
  if(WIN32)
    add_executable(VisualizerNative WIN32 production.cpp capture_service.cpp)
    target_link_libraries(VisualizerNative PRIVATE shell32)
  else()
    add_executable(VisualizerNative production.cpp capture_service.cpp)
  endif()
  target_include_directories(VisualizerNative PRIVATE "${VIS_NATIVE_COMMON_INCLUDE}" "${VIS_NATIVE_API_DIR}")
  target_link_libraries(VisualizerNative PRIVATE visualizer_window_app)
  if(APPLE)
    target_link_libraries(VisualizerNative PRIVATE proc)
    # Workbench project() remains independently versioned. The shipped app
    # must use the product's VERSION, or the independent SDK snapshot version.
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../VERSION")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../VERSION" VIS_APP_CANDIDATE_VERSION)
      string(STRIP "${VIS_APP_CANDIDATE_VERSION}" VIS_APP_CANDIDATE_VERSION)
    elseif(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../VERSION.json")
      file(READ "${CMAKE_CURRENT_SOURCE_DIR}/../VERSION.json" VIS_APP_SDK_METADATA)
      string(JSON VIS_APP_CANDIDATE_VERSION GET "${VIS_APP_SDK_METADATA}" version)
    else()
      message(FATAL_ERROR "Mac app bundle requires product VERSION or SDK VERSION.json")
    endif()
    if(NOT VIS_APP_CANDIDATE_VERSION MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)(-[A-Za-z0-9.]+)?$")
      message(FATAL_ERROR "Invalid Mac app candidate version")
    endif()
    set(MACOSX_BUNDLE_SHORT_VERSION_STRING "${CMAKE_MATCH_1}")
    set(MACOSX_BUNDLE_BUNDLE_VERSION "${CMAKE_MATCH_1}")
    set_target_properties(VisualizerNative PROPERTIES MACOSX_BUNDLE TRUE
      MACOSX_BUNDLE_GUI_IDENTIFIER "org.vlcvisualizers.native"
      MACOSX_BUNDLE_BUNDLE_NAME "VLC Visualizers"
      MACOSX_BUNDLE_SHORT_VERSION_STRING "${MACOSX_BUNDLE_SHORT_VERSION_STRING}"
      MACOSX_BUNDLE_BUNDLE_VERSION "${MACOSX_BUNDLE_BUNDLE_VERSION}"
      MACOSX_BUNDLE_INFO_PLIST "${CMAKE_CURRENT_SOURCE_DIR}/Info.plist.in")
  elseif(UNIX)
    set_target_properties(VisualizerNative PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN")
  endif()
  install(TARGETS VisualizerNative BUNDLE DESTINATION native RUNTIME DESTINATION native)
  if(MSVC)
    target_link_options(VisualizerNative PRIVATE /OPT:REF /OPT:ICF /MANIFEST:EMBED "/MANIFESTINPUT:${CMAKE_CURRENT_SOURCE_DIR}/windows.manifest")
  endif()
  if(WIN32)
    get_target_property(DAWN_DLL dawn::webgpu_dawn IMPORTED_LOCATION_RELEASE)
    get_filename_component(DAWN_DLL_DIR "${DAWN_DLL}" DIRECTORY)
    find_file(DAWN_FXC_RUNTIME d3dcompiler_47.dll PATHS "${DAWN_DLL_DIR}" NO_DEFAULT_PATH REQUIRED)
    add_custom_command(TARGET VisualizerNative POST_BUILD
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different $<TARGET_RUNTIME_DLLS:VisualizerNative> "$<TARGET_FILE_DIR:VisualizerNative>"
      COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${DAWN_FXC_RUNTIME}" "$<TARGET_FILE_DIR:VisualizerNative>"
      COMMAND_EXPAND_LISTS VERBATIM)
  endif()
endif()
